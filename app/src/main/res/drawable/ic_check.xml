<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification action icon. White with alpha only: Android draws action icons
  as a monochrome stencil and discards colour, exactly like ic_notification.

  Phones have not rendered action icons since Android 7, but the parameter is
  not optional and Wear, Auto and some launchers do draw them, so a real shape
  beats a placeholder.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M9,16.17 L4.83,12 3.41,13.41 9,19 21,7 19.59,5.59 Z"
        android:fillColor="#FFFFFF" />
</vector>
