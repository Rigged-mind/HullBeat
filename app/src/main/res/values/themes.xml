<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose draws everything; this exists only so the window has a sane
      background before the first frame and so the manifest has a theme to
      point at. Colours live in ui/theme/Color.kt.
    -->
    <style name="Theme.HullBeat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
      The launch screen, on the app icon's colour. MainActivity swaps to
      Theme.HullBeat before its first frame. values-v31 overrides this with
      the SplashScreen attributes.
    -->
    <style name="Theme.HullBeat.Starting">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
