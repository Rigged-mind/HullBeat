<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ draws the launch screen itself from these. The icon is the
      boat with the wordmark under it, one drawable: the system's own
      branding slot is pinned to the bottom edge and cannot sit under the icon.
    -->
    <style name="Theme.HullBeat.Starting" parent="Theme.HullBeat">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
