<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ draws the launch screen itself from these: the adaptive
      icon (its #04120F plate melts into the same background) and the
      wordmark the system places at the bottom.
    -->
    <style name="Theme.HullBeat.Starting" parent="Theme.HullBeat">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_wordmark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
